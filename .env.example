# Copia este archivo a .env y rellena con valores reales. NUNCA subas .env al repo.

# --- Autenticación ---
# Secreto para firmar los JWT de sesión. Mínimo 32 caracteres aleatorios.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET=

# Credenciales del consultor/superusuario de ProM.
ADMIN_EMAIL=consultant@prosuite.mx
# Usa una contraseña fuerte y única (no la del repo, que quedó comprometida).
ADMIN_PASSWORD=

# --- Integración IA (OpenCode / Kimi) ---
# ROTAR: la clave que estaba en docker-compose quedó expuesta en el historial git.
OPENCODE_API_KEY=
OPENCODE_DEFAULT_MODEL=opencode/kimi-k2.6
# Ruta opcional al archivo de entorno de OpenCode dentro del contenedor.
OPENCODE_ENV_PATH=/opt/data/.opencode.env
